"""
Fixed-format COBOL regex patterns.

This file contains regex patterns only.
"""

import re


SEQUENCE_ONLY_PATTERN = re.compile(
    r"^\s*\d{6}\s*$",
    flags=re.IGNORECASE,
)

DIVISION_PATTERN = re.compile(
    r"^\s*(?:\d{6}\s+)?[A-Z-]+\s+DIVISION\b",
    flags=re.IGNORECASE,
)

FIXED_FORMAT_LINE_PATTERN = re.compile(
    r"^(?P<left>\d{6})(?P<indicator>.)(?P<body>.{0,65})(?P<right>\d{0,8})$",
    flags=re.IGNORECASE,
)