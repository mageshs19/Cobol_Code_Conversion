"""
Fixed-format COBOL layout rules.

Columns:
- 1-6   : left sequence number
- 7     : indicator area
- 8-72  : COBOL body
- 73-80 : right sequence number

This file contains constants only.
No regex should be defined here.
"""

TOTAL_WIDTH = 80
BODY_WIDTH = 65

LEFT_SEQUENCE_WIDTH = 6
INDICATOR_WIDTH = 1
RIGHT_SEQUENCE_WIDTH = 8

DEFAULT_LEFT_START = 10
DEFAULT_LEFT_STEP = 10

SPACE_INDICATOR = " "
COMMENT_INDICATOR = "*"
DEBUG_INDICATOR = "D"
PAGE_INDICATOR = "/"

VALID_INDICATORS = {
    SPACE_INDICATOR,
    COMMENT_INDICATOR,
    DEBUG_INDICATOR,
    PAGE_INDICATOR,
}