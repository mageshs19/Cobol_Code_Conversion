"""
Generic COBOL field-usage analyzer.

Detects:
- IDMS qualified references: FIELD OF RECORD / FIELD IN RECORD
- DCLGEN qualified references: FIELD OF DCLGROUP
- DB2 host references: :DCLGROUP.FIELD
- MOVE source and target fields
- condition fields in IF / WHEN / UNTIL / EVALUATE
- output fields in output-style statements

This analyzer does not rewrite COBOL.

Architecture rule:
- Regex patterns live in patterns/field_usage_patterns.py.
- This file contains analyzer logic only.
"""

from dataclasses import dataclass, field

from idms_db2_phase2.repositories.mapping_repository import MappingRepository
from idms_db2_phase2.resolvers.table_name_resolver import TableNameResolver
from idms_db2_phase2.services.name_normalizer import NameNormalizer
from patterns.field_usage_patterns import (
    COMMENT_OR_BLANK_PATTERN,
    CONDITION_STATEMENT_PATTERN,
    DCLGEN_DOT_PATTERN,
    DCLGEN_OF_PATTERN,
    EXEC_SQL_END_PATTERN,
    EXEC_SQL_START_PATTERN,
    MOVE_STATEMENT_PATTERN,
    OUTPUT_STATEMENT_PATTERN,
    QUALIFIED_REFERENCE_PATTERN,
)
from patterns.sequence_patterns import strip_sequence_numbers


@dataclass
class FieldUsage:
    """
    Field usage collected for one COBOL record or DCLGEN group.
    """

    record_name: str
    condition_fields: set[str] = field(default_factory=set)
    output_fields: set[str] = field(default_factory=set)
    move_source_fields: set[str] = field(default_factory=set)
    move_target_fields: set[str] = field(default_factory=set)
    dclgen_host_fields: set[str] = field(default_factory=set)
    all_fields: set[str] = field(default_factory=set)


@dataclass
class FieldUsageAnalysis:
    """
    Complete field usage analysis for a COBOL program.
    """

    usage_by_record: dict[str, FieldUsage] = field(default_factory=dict)
    diagnostics: list[str] = field(default_factory=list)


class FieldUsageAnalyzer:
    """
    Analyzes COBOL text for field usage.

    This analyzer is intentionally conservative:
    - It detects qualified references only.
    - It does not rewrite bare words globally.
    - It does not invent DB2 table, column, or host variable names.
    - It preserves the original COBOL business flow.
    """

    def __init__(
        self,
        mapping_repository: MappingRepository | None = None,
        table_name_resolver: TableNameResolver | None = None,
    ) -> None:
        self.mapping_repository = mapping_repository
        self.table_name_resolver = table_name_resolver

    def analyze(
        self,
        cobol_text: str,
    ) -> FieldUsageAnalysis:
        """
        Analyze COBOL source text and return usage by record/group.
        """

        analysis = FieldUsageAnalysis()

        if not cobol_text:
            analysis.diagnostics.append(
                "Field usage analyzer: COBOL text is empty."
            )
            return analysis

        in_exec_sql = False

        for raw_line in str(cobol_text or "").splitlines():
            logical_line = self._logical_line(raw_line)

            if self._should_skip_line(logical_line):
                continue

            if EXEC_SQL_START_PATTERN.search(logical_line):
                in_exec_sql = True

            self._capture_qualified_references(
                line=logical_line,
                analysis=analysis,
            )

            self._capture_dclgen_references(
                line=logical_line,
                analysis=analysis,
            )

            if not in_exec_sql:
                self._capture_move_references(
                    line=logical_line,
                    analysis=analysis,
                )

                self._capture_condition_references(
                    line=logical_line,
                    analysis=analysis,
                )

                self._capture_output_references(
                    line=logical_line,
                    analysis=analysis,
                )

            if EXEC_SQL_END_PATTERN.search(logical_line):
                in_exec_sql = False

        self._add_summary_diagnostics(analysis)
        return analysis

    def _logical_line(
        self,
        line: str,
    ) -> str:
        """
        Strip COBOL sequence numbers and normalize the line.
        """

        text = str(line or "")
        try:
            text = strip_sequence_numbers(text)
        except Exception:
            text = text[6:] if len(text) > 6 and text[:6].isdigit() else text

        return text.strip()

    def _should_skip_line(
        self,
        line: str,
    ) -> bool:
        """
        Skip blank and comment lines.
        """

        return bool(COMMENT_OR_BLANK_PATTERN.match(str(line or "")))

    def _capture_qualified_references(
        self,
        line: str,
        analysis: FieldUsageAnalysis,
    ) -> None:
        """
        Capture FIELD OF RECORD and FIELD IN RECORD references.
        """

        for match in QUALIFIED_REFERENCE_PATTERN.finditer(line):
            field_name = self._normalize(match.group("field"))
            record_name = self._normalize(match.group("record"))

            if not field_name or not record_name:
                continue

            usage = self._usage_for_record(
                analysis=analysis,
                record_name=record_name,
            )

            usage.all_fields.add(field_name)

            if CONDITION_STATEMENT_PATTERN.match(line):
                usage.condition_fields.add(field_name)

            if OUTPUT_STATEMENT_PATTERN.match(line):
                usage.output_fields.add(field_name)

    def _capture_dclgen_references(
        self,
        line: str,
        analysis: FieldUsageAnalysis,
    ) -> None:
        """
        Capture DCLGEN host references:
        - FIELD OF DCLGROUP
        - :DCLGROUP.FIELD
        """

        for match in DCLGEN_OF_PATTERN.finditer(line):
            field_name = self._normalize(match.group("field"))
            group_name = self._normalize(match.group("group"))

            if not field_name or not group_name:
                continue

            usage = self._usage_for_record(
                analysis=analysis,
                record_name=group_name,
            )

            usage.dclgen_host_fields.add(field_name)
            usage.all_fields.add(field_name)

        for match in DCLGEN_DOT_PATTERN.finditer(line):
            field_name = self._normalize(match.group("field"))
            group_name = self._normalize(match.group("group"))

            if not field_name or not group_name:
                continue

            usage = self._usage_for_record(
                analysis=analysis,
                record_name=group_name,
            )

            usage.dclgen_host_fields.add(field_name)
            usage.all_fields.add(field_name)

    def _capture_move_references(
        self,
        line: str,
        analysis: FieldUsageAnalysis,
    ) -> None:
        """
        Capture qualified references from MOVE source and target sides.
        """

        match = MOVE_STATEMENT_PATTERN.match(line)

        if not match:
            return

        source_text = match.group("source") or ""
        target_text = match.group("target") or ""

        self._capture_move_side(
            text=source_text,
            analysis=analysis,
            is_source=True,
        )

        self._capture_move_side(
            text=target_text,
            analysis=analysis,
            is_source=False,
        )

    def _capture_move_side(
        self,
        text: str,
        analysis: FieldUsageAnalysis,
        is_source: bool,
    ) -> None:
        """
        Capture qualified references from one side of a MOVE statement.
        """

        for match in QUALIFIED_REFERENCE_PATTERN.finditer(text):
            field_name = self._normalize(match.group("field"))
            record_name = self._normalize(match.group("record"))

            if not field_name or not record_name:
                continue

            usage = self._usage_for_record(
                analysis=analysis,
                record_name=record_name,
            )

            if is_source:
                usage.move_source_fields.add(field_name)
            else:
                usage.move_target_fields.add(field_name)

            usage.all_fields.add(field_name)

    def _capture_condition_references(
        self,
        line: str,
        analysis: FieldUsageAnalysis,
    ) -> None:
        """
        Capture qualified references from condition statements.
        """

        if not CONDITION_STATEMENT_PATTERN.match(line):
            return

        for match in QUALIFIED_REFERENCE_PATTERN.finditer(line):
            field_name = self._normalize(match.group("field"))
            record_name = self._normalize(match.group("record"))

            if not field_name or not record_name:
                continue

            usage = self._usage_for_record(
                analysis=analysis,
                record_name=record_name,
            )

            usage.condition_fields.add(field_name)
            usage.all_fields.add(field_name)

    def _capture_output_references(
        self,
        line: str,
        analysis: FieldUsageAnalysis,
    ) -> None:
        """
        Capture qualified references from output-style statements.
        """

        if not OUTPUT_STATEMENT_PATTERN.match(line):
            return

        for match in QUALIFIED_REFERENCE_PATTERN.finditer(line):
            field_name = self._normalize(match.group("field"))
            record_name = self._normalize(match.group("record"))

            if not field_name or not record_name:
                continue

            usage = self._usage_for_record(
                analysis=analysis,
                record_name=record_name,
            )

            usage.output_fields.add(field_name)
            usage.all_fields.add(field_name)

    def _usage_for_record(
        self,
        analysis: FieldUsageAnalysis,
        record_name: str,
    ) -> FieldUsage:
        """
        Return existing usage for a record/group or create a new entry.
        """

        normalized_record_name = self._normalize(record_name)

        if normalized_record_name not in analysis.usage_by_record:
            analysis.usage_by_record[normalized_record_name] = FieldUsage(
                record_name=normalized_record_name,
            )

        return analysis.usage_by_record[normalized_record_name]

    def _normalize(
        self,
        value: str,
    ) -> str:
        """
        Normalize names using project NameNormalizer when available.
        """

        text = str(value or "").strip()

        if not text:
            return ""

        try:
            return NameNormalizer.normalize(text)
        except Exception:
            return text.upper().replace("_", "-")

    def _add_summary_diagnostics(
        self,
        analysis: FieldUsageAnalysis,
    ) -> None:
        """
        Add concise diagnostics for observability.
        """

        record_count = len(analysis.usage_by_record)

        analysis.diagnostics.append(
            f"Field usage analyzer: records/groups detected: {record_count}."
        )

        for record_name in sorted(analysis.usage_by_record):
            usage = analysis.usage_by_record[record_name]
            field_count = len(usage.all_fields)

            analysis.diagnostics.append(
                "Field usage analyzer: "
                f"{record_name} fields detected: {field_count}."
            )