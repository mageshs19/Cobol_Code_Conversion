"""
Main conversion orchestration service.

This service keeps conversion orchestration small.

Responsibilities:
- Validate input.
- Build repositories and resolvers.
- Run COBOL transformation.
- Generate DB2 infrastructure.
- Generate cursor paragraphs.
- Apply optional PIC auto-fix.
- Run production validation.
- Return ConversionResult.

Rules:
- No regex patterns in this file.
- No hardcoded DB2 table or column names in this file.
- No parser column aliases in this file.
- No direct COBOL rewrite logic in this file.
"""

from idms_db2_phase2.domain.models import ConversionInput, ConversionResult
from idms_db2_phase2.generators.cursor_paragraph_generator import (
    CursorParagraphGenerator,
)
from idms_db2_phase2.generators.db2_infrastructure_generator import (
    Db2InfrastructureGenerator,
)
from idms_db2_phase2.generators.sql_error_generator import SqlErrorGenerator
from idms_db2_phase2.generators.sql_generator import SqlGenerator
from idms_db2_phase2.generators.timestamp_generator import TimestampGenerator
from idms_db2_phase2.repositories.copybook_repository import CopybookRepository
from idms_db2_phase2.repositories.dclgen_repository import DclgenRepository
from idms_db2_phase2.repositories.mapping_repository import MappingRepository
from idms_db2_phase2.resolvers.column_name_resolver import ColumnNameResolver
from idms_db2_phase2.resolvers.cursor_name_resolver import CursorNameResolver
from idms_db2_phase2.resolvers.host_variable_resolver import HostVariableResolver
from idms_db2_phase2.resolvers.record_context_resolver import RecordContextResolver
from idms_db2_phase2.resolvers.table_name_resolver import TableNameResolver
from idms_db2_phase2.services.validation_service import ValidationService
from idms_db2_phase2.transformers.cobol_transformer import CobolTransformer
from idms_db2_phase2.transformers.field_reference_rewriter import (
    FieldReferenceRewriter,
)
from idms_db2_phase2.transformers.idms_statement_transformer import (
    IdmsStatementTransformer,
)
from idms_db2_phase2.transformers.pic_length_auto_fixer import PicLengthAutoFixer
from idms_db2_phase2.validators.input_validator import InputValidator
from idms_db2_phase2.validators.mapping_validator import MappingValidator
from idms_db2_phase2.validators.production_validator import ProductionValidator


class ConversionService:
    """
    Orchestrates IDMS COBOL to DB2 COBOL conversion.
    """

    def __init__(
        self,
        validation_service: ValidationService | None = None,
    ) -> None:
        self.validation_service = validation_service or ValidationService()

    def convert(
        self,
        conversion_input: ConversionInput,
    ) -> ConversionResult:
        """
        Convert IDMS COBOL source into DB2 embedded SQL COBOL.
        """

        validation_messages: list[str] = []
        operations = []

        validation_messages.extend(
            self._validate_input(conversion_input)
        )

        if validation_messages:
            return self._result(
                converted_cobol="",
                validation_messages=validation_messages,
                operations=operations,
            )

        context = self._build_context(conversion_input)

        validation_messages.extend(
            self._validate_mapping(context)
        )

        converted_cobol = self._transform_cobol(
            conversion_input=conversion_input,
            context=context,
        )

        operations = self._operations_from_context(context)

        converted_cobol = self._apply_db2_infrastructure(
            cobol_text=converted_cobol,
            operations=operations,
            context=context,
            validation_messages=validation_messages,
        )

        converted_cobol = self._apply_cursor_paragraphs(
            cobol_text=converted_cobol,
            operations=operations,
            context=context,
            validation_messages=validation_messages,
        )

        converted_cobol = self._apply_optional_pic_auto_fix(
            cobol_text=converted_cobol,
            conversion_input=conversion_input,
            context=context,
            validation_messages=validation_messages,
        )

        validation_messages.extend(
            self._validate_production(
                cobol_text=converted_cobol,
                context=context,
            )
        )

        return self._result(
            converted_cobol=converted_cobol,
            validation_messages=validation_messages,
            operations=operations,
        )

    def _validate_input(
        self,
        conversion_input: ConversionInput,
    ) -> list[str]:
        """
        Run input validation.

        Existing project may contain InputValidator, while the service-level
        ValidationService centralizes message text. Both are supported safely.
        """

        messages: list[str] = []

        messages.extend(
            self.validation_service.validate(conversion_input)
        )

        if messages:
            return messages

        try:
            input_validator = InputValidator()
            messages.extend(input_validator.validate(conversion_input))
        except Exception:
            pass

        return messages

    def _build_context(
        self,
        conversion_input: ConversionInput,
    ) -> dict[str, object]:
        """
        Build repositories, resolvers, transformers, and generators.
        """

        mapping_repository = MappingRepository(
            conversion_input.sheet_mapping_rows
        )

        dclgen_repository = DclgenRepository(
            conversion_input.dclgen_columns
        )

        copybook_repository = CopybookRepository(
            conversion_input.copybook_fields
        )

        table_name_resolver = TableNameResolver(
            mapping_repository=mapping_repository,
            dclgen_repository=dclgen_repository,
        )

        column_name_resolver = ColumnNameResolver(
            mapping_repository=mapping_repository,
            dclgen_repository=dclgen_repository,
        )

        host_variable_resolver = HostVariableResolver(
            dclgen_repository=dclgen_repository,
            table_name_resolver=table_name_resolver,
            column_name_resolver=column_name_resolver,
        )

        cursor_name_resolver = CursorNameResolver()

        record_context_resolver = RecordContextResolver(
            mapping_repository=mapping_repository,
        )

        sql_generator = SqlGenerator(
            mapping_repository=mapping_repository,
            dclgen_repository=dclgen_repository,
            table_name_resolver=table_name_resolver,
            column_name_resolver=column_name_resolver,
            host_variable_resolver=host_variable_resolver,
        )

        sql_error_generator = SqlErrorGenerator()

        timestamp_generator = TimestampGenerator(
            mapping_repository=mapping_repository,
            dclgen_repository=dclgen_repository,
            table_name_resolver=table_name_resolver,
            column_name_resolver=column_name_resolver,
            host_variable_resolver=host_variable_resolver,
        )

        field_reference_rewriter = FieldReferenceRewriter(
            mapping_repository=mapping_repository,
            dclgen_repository=dclgen_repository,
            table_name_resolver=table_name_resolver,
            column_name_resolver=column_name_resolver,
            host_variable_resolver=host_variable_resolver,
        )

        idms_statement_transformer = IdmsStatementTransformer(
            mapping_repository=mapping_repository,
            dclgen_repository=dclgen_repository,
            table_name_resolver=table_name_resolver,
            column_name_resolver=column_name_resolver,
            host_variable_resolver=host_variable_resolver,
            sql_generator=sql_generator,
            sql_error_generator=sql_error_generator,
            timestamp_generator=timestamp_generator,
            record_context_resolver=record_context_resolver,
        )

        cobol_transformer = CobolTransformer(
            idms_statement_transformer=idms_statement_transformer,
            field_reference_rewriter=field_reference_rewriter,
        )

        db2_infrastructure_generator = Db2InfrastructureGenerator(
            mapping_repository=mapping_repository,
            dclgen_repository=dclgen_repository,
            table_name_resolver=table_name_resolver,
            column_name_resolver=column_name_resolver,
            host_variable_resolver=host_variable_resolver,
            cursor_name_resolver=cursor_name_resolver,
        )

        cursor_paragraph_generator = CursorParagraphGenerator(
            mapping_repository=mapping_repository,
            dclgen_repository=dclgen_repository,
            table_name_resolver=table_name_resolver,
            column_name_resolver=column_name_resolver,
            host_variable_resolver=host_variable_resolver,
            cursor_name_resolver=cursor_name_resolver,
        )

        production_validator = ProductionValidator(
            dclgen_repository=dclgen_repository,
        )

        mapping_validator = MappingValidator(
            mapping_repository=mapping_repository,
            dclgen_repository=dclgen_repository,
        )

        return {
            "mapping_repository": mapping_repository,
            "dclgen_repository": dclgen_repository,
            "copybook_repository": copybook_repository,
            "table_name_resolver": table_name_resolver,
            "column_name_resolver": column_name_resolver,
            "host_variable_resolver": host_variable_resolver,
            "cursor_name_resolver": cursor_name_resolver,
            "record_context_resolver": record_context_resolver,
            "sql_generator": sql_generator,
            "sql_error_generator": sql_error_generator,
            "timestamp_generator": timestamp_generator,
            "field_reference_rewriter": field_reference_rewriter,
            "idms_statement_transformer": idms_statement_transformer,
            "cobol_transformer": cobol_transformer,
            "db2_infrastructure_generator": db2_infrastructure_generator,
            "cursor_paragraph_generator": cursor_paragraph_generator,
            "production_validator": production_validator,
            "mapping_validator": mapping_validator,
        }

    def _validate_mapping(
        self,
        context: dict[str, object],
    ) -> list[str]:
        """
        Run mapping validation when available.
        """

        validator = context.get("mapping_validator")

        if not validator:
            return []

        try:
            return validator.validate()
        except TypeError:
            return validator.validate(
                mapping_repository=context.get("mapping_repository"),
                dclgen_repository=context.get("dclgen_repository"),
            )
        except Exception as exc:
            return [f"Mapping validation skipped: {exc}"]

    def _transform_cobol(
        self,
        conversion_input: ConversionInput,
        context: dict[str, object],
    ) -> str:
        """
        Run COBOL transformation.
        """

        transformer = context["cobol_transformer"]
        source_text = conversion_input.idms_cobol_text or ""

        try:
            return transformer.transform(
                cobol_text=source_text,
                target_program_id=conversion_input.target_program_id,
            )
        except TypeError:
            try:
                return transformer.transform(conversion_input)
            except TypeError:
                return transformer.transform(source_text)

    def _operations_from_context(
        self,
        context: dict[str, object],
    ) -> list[object]:
        """
        Get detected IDMS operations from the statement transformer when present.
        """

        transformer = context.get("idms_statement_transformer")

        if transformer is None:
            return []

        operations = getattr(transformer, "operations", None)

        if operations is None:
            operations = getattr(transformer, "last_operations", None)

        return list(operations or [])

    def _apply_db2_infrastructure(
        self,
        cobol_text: str,
        operations: list[object],
        context: dict[str, object],
        validation_messages: list[str],
    ) -> str:
        """
        Insert DB2 infrastructure block.
        """

        generator = context.get("db2_infrastructure_generator")

        if generator is None:
            return cobol_text

        try:
            updated, messages = generator.apply(
                cobol_text=cobol_text,
                operations=operations,
            )
            validation_messages.extend(messages)
            return updated
        except Exception as exc:
            validation_messages.append(
                f"DB2 infrastructure generation skipped: {exc}"
            )
            return cobol_text

    def _apply_cursor_paragraphs(
        self,
        cobol_text: str,
        operations: list[object],
        context: dict[str, object],
        validation_messages: list[str],
    ) -> str:
        """
        Insert cursor OPEN/FETCH/CLOSE paragraphs.
        """

        generator = context.get("cursor_paragraph_generator")

        if generator is None:
            return cobol_text

        try:
            updated, messages = generator.apply(
                cobol_text=cobol_text,
                operations=operations,
            )
            validation_messages.extend(messages)
            return updated
        except Exception as exc:
            validation_messages.append(
                f"Cursor paragraph generation skipped: {exc}"
            )
            return cobol_text

    def _apply_optional_pic_auto_fix(
        self,
        cobol_text: str,
        conversion_input: ConversionInput,
        context: dict[str, object],
        validation_messages: list[str],
    ) -> str:
        """
        Apply optional PIC length auto-fix.
        """

        enabled = bool(
            getattr(
                conversion_input,
                "auto_fix_pic_length_mismatches",
                False,
            )
        )

        if not enabled:
            return cobol_text

        try:
            fixer = PicLengthAutoFixer(
                dclgen_repository=context.get("dclgen_repository"),
            )
            updated = fixer.fix(cobol_text)
            validation_messages.extend(getattr(fixer, "messages", []))
            return updated
        except Exception as exc:
            validation_messages.append(
                f"PIC length auto-fix skipped: {exc}"
            )
            return cobol_text

    def _validate_production(
        self,
        cobol_text: str,
        context: dict[str, object],
    ) -> list[str]:
        """
        Run production validation.
        """

        validator = context.get("production_validator")

        if validator is None:
            return []

        try:
            return validator.validate(cobol_text)
        except Exception as exc:
            return [f"Production validation skipped: {exc}"]

    def _result(
        self,
        converted_cobol: str,
        validation_messages: list[str],
        operations: list[object],
    ) -> ConversionResult:
        """
        Build ConversionResult while supporting the existing project model.
        """

        try:
            return ConversionResult(
                converted_cobol=converted_cobol,
                validation_messages=validation_messages,
                operations=operations,
            )
        except TypeError:
            return ConversionResult(
                converted_cobol_text=converted_cobol,
                messages=validation_messages,
                operations=operations,
            )

